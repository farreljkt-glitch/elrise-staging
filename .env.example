# MySQL khusus HRIS. Jangan gunakan user root.
DATABASE_URL="mysql://hris_app:GANTI_PASSWORD@127.0.0.1:3306/hris_db"
AUTH_SECRET="GANTI_DENGAN_RANDOM_MINIMAL_32_BYTE"
GAJIKU_DB_NAME="gajiku_db"
UPLOAD_DIR="/var/lib/terhubung-gajiku/uploads"
APP_TIMEZONE="Asia/Jakarta"
# Dipakai hanya saat seed awal; hapus dari environment setelah seed.
SEED_SUPERADMIN_EMAIL="superadmin@elkyno.com"
SEED_SUPERADMIN_PASSWORD="GANTI_PASSWORD_KUAT_MINIMAL_16_KARAKTER"
# Only enable IP-based attendance after securing reverse proxy and port 3000.
# Must match a secret injected by your reverse proxy AFTER it strips incoming client headers.
# Do NOT reuse AUTH_SECRET. Use 32+ random bytes, stored in secret manager.
PROXY_TRUST_SECRET="GANTI_RANDOM_RAHASIA_PROXY_MINIMAL_32_BYTE"
